# =============================================================
# Frontend Environment Variables
# =============================================================
#
# Kopiere diese Datei nach .env.local und passe die Werte an.
# .env.local ist von Git ignoriert (siehe .gitignore).
#
# Konvention:
#  - NEXT_PUBLIC_*  -> wird in den Browser-Bundle kompiliert (sichtbar fuer Endnutzer)
#  - Alles andere   -> nur server-side verfuegbar (Server Components, Route Handlers)

# -------------------------------------------------------------
# Backend-URLs
# -------------------------------------------------------------
# Browser-seitig sichtbar. In Production typischerweise die
# oeffentliche API-URL (z.B. https://api.kontura-ai.de).
# In lokaler Entwicklung: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-seitig (nicht im Browser-Bundle). In Production kann das
# die INTERNE Backend-URL sein (z.B. http://backend:8000 bei Docker-
# Compose oder fly-internal in Fly.io). Lokal identisch zur public-URL.
API_BASE_URL=http://localhost:8000