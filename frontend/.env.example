# URL des FastAPI-Backends
# Lokale Entwicklung: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to enable the demo banner and the demo-login button on /login.
# The backend must ALSO have KONTURA_DEMO_MODE=true for the endpoints to work.
NEXT_PUBLIC_DEMO_MODE=false
