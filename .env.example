APP_NAME=Kontura AI
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=kontura
POSTGRES_USER=kontura
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql+asyncpg://kontura:change_me_in_local_env@localhost:5433/kontura

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# KI-Provider
# Aktuell unterstuetzt: openai. Geplant: azure (EU), ollama (self-hosted).
# ==========================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini