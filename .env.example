APP_NAME=Kontura AI
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# PostgreSQL
# Port 5433 default, da 5432 oft belegt ist (Anaconda, native Postgres-Installation, etc.)
# ==========================================
POSTGRES_DB=kontura
POSTGRES_USER=kontura
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql+asyncpg://kontura:change_me_in_local_env@localhost:5433/kontura

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0