APP_NAME=Kontura AI
APP_ENV=development
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=kontura
POSTGRES_USER=kontura
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql+asyncpg://kontura:change_me_in_local_env@localhost:5433/kontura

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# KI-Provider
# Aktuell unterstuetzt: openai. Geplant: azure (EU), ollama (self-hosted).
# ==========================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ==========================================
# KI-Extraktion (G2.1)
# Rechnungs-Extraktion via GPT-4o Vision (structured outputs).
# ==========================================
# Vision-Modell fuer Rechnungs-Extraktion (gpt-4o empfohlen, gpt-4o-mini moeglich)
OPENAI_VISION_MODEL=gpt-4o
# Maximale Seitenanzahl fuer PDF-Rendering (Schutz vor Riesen-PDFs)
EXTRACTION_MAX_PDF_PAGES=10
# DPI-Aufloesung beim PDF-Rendering via PyMuPDF
EXTRACTION_PDF_DPI=150

# ==========================================
# DATEV-Export (G4.0)
# ==========================================
# Beraternummer (Dummy-Default fuer lokale Entwicklung)
DATEV_CONSULTANT_NUMBER=12345
# Mandantennummer in DATEV
DATEV_CLIENT_NUMBER=67890
# Wirtschaftsjahr-Beginn (YYYY-MM-DD)
DATEV_FISCAL_YEAR_START=2026-01-01
# Sachkontenlaenge (typisch 4)
DATEV_ACCOUNT_LENGTH=4
# Default-Aufwandskonto (z.B. SKR03 Wareneingang)
DATEV_DEFAULT_EXPENSE_ACCOUNT=3400
# Default-Kreditorenkonto
DATEV_DEFAULT_CREDITOR_ACCOUNT=70000