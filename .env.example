# ==========================================
# Kontura AI — Umgebungsvariablen (Template)
# ==========================================
# Kopiere diese Datei zu `.env` und passe die Werte an.
# `.env` ist in `.gitignore` — kommt NIEMALS ins Repository.

# Anwendung
APP_NAME=Kontura AI
APP_ENV=development
APP_VERSION=0.1.0

# HTTP-Server
HOST=0.0.0.0
PORT=8000

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO